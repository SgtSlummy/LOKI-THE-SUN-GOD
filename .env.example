DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-application-id
DISCORD_GUILD_ID=replace-with-development-guild-id
BOT_ADMIN_USER_IDS=replace-with-discord-user-id

DATABASE_URL=sqlite:///loki-relay.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

BOT_ENV=development
LOG_LEVEL=info
MAX_ACTIVE_PLUGINS=8
HEALTH_PORT=8080
LOKI_GUARDIAN_HEALTH_URL=http://127.0.0.1:8080/healthz
LOKI_GUARDIAN_CHECK_INTERVAL=30
LOKI_GUARDIAN_STARTUP_GRACE=90
LOKI_GUARDIAN_FAILURE_THRESHOLD=6
LOKI_GUARDIAN_MAX_RESTARTS_PER_24H=20
LOKI_GUARDIAN_BASE_RESTART_DELAY=30
LOKI_GUARDIAN_MAX_RESTART_DELAY=900

RELAY_CONFIG_JSON=
MEDIA_MODE=clean
MEDIA_LINK_BUTTONS=false
WEBHOOK_RELAY_MODE=false
ALLOW_BOT_RELAY=false

AUTOCURATOR_ENABLED=false
AUTOCURATOR_AUTOPOST=false
SERVER_SEARCH_ENABLED=false
LLM_CHAT_ENABLED=false
FAUST_AGI_ENABLED=false
FAUST_AGI_BASE_URL=
FAUST_AGI_API_KEY=
FAUST_AGI_TIMEOUT_SECONDS=300
FAUST_AGI_RUN_PATH=/api/faust/run
FAUST_AGI_ROUTE_MODE=local_first
FAUST_AGI_PROVIDER=
FAUST_AGI_EXECUTE=true
FAUST_AGI_TARGET_COMPONENT=discord
FAUST_AGI_UNPROMPTED_CONTINUATIONS_ENABLED=false
FAUST_AGI_UNPROMPTED_MAX_TURNS=1
FAUST_AGI_UNPROMPTED_MAX_DELAY_SECONDS=30
MUSIC_ENABLED=false

RAILWAY_TOKEN=
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_PROJECT_NAME=loki-discord-relay
RAILWAY_SERVICE_NAME=loki-discord-relay
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT=production
